# ===== LiAuto-Mate 配置（复制为 .env 并填写）=====
# 本地进程的环境变量优先于 .env。Compose 仅向容器传入 compose.yml 中声明的变量。

# --- 必填 ---
# Web UI 访问密码。Compose 启动时必填，本地留空会放行页面访问。
LIAM_UI_PASSWORD=

# --- 登录/账号 ---
# 手机号（可选，填写后在网页重登面板预填，仍可修改）
LIAM_PHONE=
# 网页登录内置浏览器是否无头运行（1=无头；0=有界面，便于观察滑块）
LIAM_LOGIN_HEADLESS=1
# 数据目录（SQLite + 加密凭据全部在此；容器内挂 /data 卷）
LIAM_DATA_DIR=./data

# --- 采集节奏（§6.3 分档，全部可配）---
# T1 实时全量批（awake 态）秒
LIAM_POLL_REALTIME=60
# T1loc 行驶定位采样间隔（秒）
LIAM_POLL_DRIVE_LOC=10
# T1chg 充电采样间隔（秒）
LIAM_POLL_CHARGE=30
# T2 配置档秒
LIAM_POLL_CONFIG=3600
# T0 休眠轻探测秒（可配 300-900 更保守）
LIAM_POLL_SLEEP_PROBE=60

# --- 存储与能耗 ---
# state_history 原始 change 保留天数（0=永久）
LIAM_RETENTION_DAYS=90
# 用于按 SOC 差估算能耗的电池容量（kWh），按车型调整
LIAM_BATTERY_KWH=42.8

# --- MCP（SDK 随服务安装，令牌留空即关闭）---
LIAM_MCP_TOKEN=

# --- 地图（§8.1.1）---
# 预留的高德 JS API key。当前行程地图直接使用高德栅格瓦片。
LIAM_AMAP_KEY=
# 预留的地图提供方选项，行程地图尚未按此值切换。
LIAM_MAP_PROVIDER=amap

# --- 服务 ---
LIAM_HOST=0.0.0.0
LIAM_PORT=8080
# UI Cookie 签名密钥（留空会生成并保存到 SQLite 的 meta 表）
LIAM_SECRET_KEY=
