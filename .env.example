# ===== LiAuto-Mate 配置（复制为 .env 并填写）=====
# 全部配置均可经环境变量覆盖；容器内数据目录固定 /data

# --- 必填 ---
# Web UI 访问密码（首启向导也可设置）
LIAM_UI_PASSWORD=

# --- 登录/账号 ---
# 手机号（重登面板预填用；UI 掩码显示）
LIAM_PHONE=
# 数据目录（SQLite + 加密凭据全部在此；容器内挂 /data 卷）
LIAM_DATA_DIR=./data

# --- 采集节奏（§6.3 分档，全部可配）---
# T1 实时全量批（awake 态）秒
LIAM_POLL_REALTIME=60
# T1++ 行驶定位微轮询秒（下限 5，文档标注风控提示）
LIAM_POLL_DRIVE_LOC=10
# T1+ 充电采样秒
LIAM_POLL_CHARGE=30
# T2 配置档秒
LIAM_POLL_CONFIG=3600
# T0 休眠轻探测秒（可配 300-900 更保守）
LIAM_POLL_SLEEP_PROBE=60

# --- 存储 ---
# state_history 原始 change 保留天数（0=永久）
LIAM_RETENTION_DAYS=90

# --- MCP（§8.3：未设置即整体关闭）---
LIAM_MCP_TOKEN=

# --- 地图（§8.1.1）---
# 高德 JS API key；未设置 → 自动退回高德栅格瓦片直连（免 key）
LIAM_AMAP_KEY=
# 强制指定 provider: amap | osm（默认 amap）
LIAM_MAP_PROVIDER=amap

# --- 服务 ---
LIAM_HOST=0.0.0.0
LIAM_PORT=8080
# UI 会话密钥（留空则启动时随机生成并写 data/；重启丢失=重新登录 UI 而已）
LIAM_SECRET_KEY=
